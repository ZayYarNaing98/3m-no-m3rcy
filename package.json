{
  "name": "em-no-mercy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @nomercy/web && npm run dev -w @nomercy/worker",
    "dev:web": "npm run dev -w @nomercy/web",
    "build": "npm run build -w @nomercy/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run build && npm run deploy -w @nomercy/worker"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0",
    "@cloudflare/vitest-plugin": "^1.3.1"
  }
}
